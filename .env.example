# Supabase 프로젝트 연결에 필요한 환경변수 이름만 기록합니다. 실제 값은 .env.local에만 넣고 커밋하지 않습니다.

# Supabase 프로젝트 API 주소 (브라우저에서도 사용 -> NEXT_PUBLIC_ 접두사 필요)
NEXT_PUBLIC_SUPABASE_URL=

# 공개해도 되는 키 (RLS로 접근 범위가 제한됨, 브라우저에서도 사용)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 관리자 전용 서버 코드에서만 사용하는 비밀 키 (RLS를 우회함, 절대 브라우저에 노출하지 않음)
# 관리자 기능을 만드는 다음 단계에서 Supabase 대시보드에서 직접 값을 채워 넣습니다.
SUPABASE_SERVICE_ROLE_KEY=

# --- 새 문의 알림 메일 (선택) ---
# 아래 두 값이 비어 있으면 알림만 건너뛰고 Contact 폼과 문의 저장은 그대로 동작합니다.
# resend.com에서 발급받는 비밀 키입니다. 절대 브라우저에 노출하거나 커밋하지 않습니다.
RESEND_API_KEY=
# 새 문의 알림을 받을 주소 (Resend 계정에 등록한 본인 이메일)
CONTACT_NOTIFY_TO=
# 발신자 표시. 개인 도메인을 Resend에 등록하기 전까지는 비워두면 기본값(onboarding@resend.dev)을 사용합니다.
CONTACT_NOTIFY_FROM=

# --- Tech Radar 다이제스트 요약 (선택) ---
# console.anthropic.com에서 발급받는 비밀 키입니다. 호출할 때마다 비용이 발생합니다.
# 비어 있으면 "오늘의 다이제스트 만들기" 버튼이 오류 메시지를 보여줄 뿐, 다른 기능에는 영향이 없습니다.
ANTHROPIC_API_KEY=
